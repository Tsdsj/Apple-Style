# Template only: requires explicit author approval before enabling/deploying.
# Copy to .github/workflows/deploy-pages.yml AFTER approval and configuring Pages.
name: Deploy approved demo
on:
  workflow_dispatch:
permissions:
  contents: read
  pages: write
  id-token: write
concurrency:
  group: pages
  cancel-in-progress: false
jobs:
  deploy:
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/configure-pages@v5
      - run: bash scripts/prepare-demo.sh "$RUNNER_TEMP/apple-style-site"
      - uses: actions/upload-pages-artifact@v3
        with:
          path: ${{ runner.temp }}/apple-style-site
      - uses: actions/deploy-pages@v4
        id: deployment
